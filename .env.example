# Native Go: export these in your shell; Go does not automatically load .env.
# Bind addresses and outgoing peer targets are configured separately.
PURCHASE_SERVICE_GRPC_ADDR=127.0.0.1:50051
APPROVAL_SERVICE_GRPC_ADDR=127.0.0.1:50052
PURCHASE_SERVICE_GRPC_TARGET=localhost:50051
APPROVAL_SERVICE_GRPC_TARGET=localhost:50052
GRPC_CALL_TIMEOUT=2s
SHUTDOWN_TIMEOUT=5s

# Phase 04 HTTP gateway; only this service exposes browser REST/JSON.
API_GATEWAY_HTTP_ADDR=127.0.0.1:8080
VUE_ORIGIN=http://localhost:5173
HTTP_MAX_BODY_BYTES=65536
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Leave empty for in-memory mode. Set a real local URL only in your shell/.env.
# Example shape: postgres://USER:PASSWORD@localhost:5432/procureflow_dev?sslmode=disable
DATABASE_URL=
DATABASE_TIMEOUT=5s
# Integration tests create/drop their own databases; this role needs CREATEDB.
# No fallback to DATABASE_URL: an unset test URL explicitly skips database tests.
TEST_DATABASE_URL=

# Reserved configuration from Phase 00, not used by the current backend.
APP_ENV=development

# Reserved native placeholders (Compose uses COMPOSE_POSTGRES_* below).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=procureflow_dev
POSTGRES_USER=procureflow_local
POSTGRES_PASSWORD=replace_with_a_local_only_password

# Vite exposes VITE_ variables to the browser. Never place secrets in them.
VITE_API_BASE_URL=http://localhost:8080

# Phase 08 optional policy RAG. Empty key/models keep the assistant NOT CONFIGURED.
# Never put OPENAI_API_KEY into a VITE_ setting or commit a populated .env.
OPENAI_API_KEY=
EMBEDDING_MODEL=
# Supported models: text-embedding-3-small (1-1536), text-embedding-3-large (1-3072).
# The same model/dimension must be used for import and questions.
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=
AI_DATABASE_URL=
POLICY_DIR=policies
ASSISTANT_GRPC_ADDR=127.0.0.1:50053
# Empty by default. Native: localhost:50053; Compose: assistant-service:50053.
ASSISTANT_GRPC_TARGET=
ASSISTANT_CALL_TIMEOUT=10s
ASSISTANT_REQUEST_TIMEOUT=8s
AI_PROVIDER_TIMEOUT=6s
AI_TOP_K=3
AI_MAX_COSINE_DISTANCE=0.35
AI_MAX_OUTPUT_TOKENS=512
# Optional real-pgvector tests, isolated databases with fake provider (no API calls).
AI_TEST_DATABASE_URL=

# Phase 06 Compose: PUBLIC, DEVELOPMENT-ONLY local demo credentials.
# Compose reads .env automatically; native Go commands still require shell exports.
# Keep these credentials URI-safe. Never use real/production secrets here.
COMPOSE_POSTGRES_DB=procureflow_dev
COMPOSE_POSTGRES_USER=procureflow_dev
COMPOSE_POSTGRES_PASSWORD=procureflow_dev_only
COMPOSE_FRONTEND_PORT=5173
COMPOSE_GATEWAY_PORT=8080

# PUBLIC DEVELOPMENT-ONLY credentials for the separate optional AI database.
COMPOSE_AI_POSTGRES_DB=procureflow_policy_dev
COMPOSE_AI_POSTGRES_USER=policy_dev
COMPOSE_AI_POSTGRES_PASSWORD=policy_dev_only

# Local auth: generate once with go run ./cmd/auth-setup (never paste keys here).
# Host paths; Compose uses read-only /run/secrets mounts instead.
# Gateway and auth-seed only; Purchase/Approval Services keep DATABASE_URL.
# Native commands require a real local URL. Compose supplies its own URL.
AUTH_DATABASE_URL=
# Legacy hashes are read ONLY by auth-seed, not by runtime login.
SERVICE_AUTH_KEY_FILE=secrets/service-auth.key
AUTH_COOKIE_SECURE=false
